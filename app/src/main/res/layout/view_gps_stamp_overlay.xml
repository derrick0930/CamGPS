<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stampContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_gps_stamp_card"
    android:padding="8dp">

    <!-- Mini Map Thumbnail Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/mapCard"
        android:layout_width="105dp"
        android:layout_height="0dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#1A202C"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/ivMapTile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Map Location" />
    </androidx.cardview.widget.CardView>

    <!-- Header Location: Title (e.g. Kecamatan Mojoagung, Jawa Timur, Indonesia) -->
    <TextView
        android:id="@+id/tvLocationTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="60dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Locating device..."
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/mapCard"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Brand badge at top right -->
    <TextView
        android:id="@+id/tvBrandTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#66000000"
        android:paddingHorizontal="4dp"
        android:paddingVertical="1dp"
        android:text="CamGPS"
        android:textColor="#CCCCCC"
        android:textSize="9sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Full Address details -->
    <TextView
        android:id="@+id/tvAddressDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="Waiting for GPS lock..."
        android:textColor="#E0E0E0"
        android:textSize="10sp"
        android:lineSpacingExtra="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/mapCard"
        app:layout_constraintTop_toBottomOf="@id/tvLocationTitle" />

    <!-- Coordinates: Lat -7.567445° Long 112.345482° -->
    <TextView
        android:id="@+id/tvCoordinates"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="2dp"
        android:text="Lat --.------° Long --.------°"
        android:textColor="#FFFFFF"
        android:textSize="10.5sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/mapCard"
        app:layout_constraintTop_toBottomOf="@id/tvAddressDetails" />

    <!-- Timestamp & Timezone: Jumat, 19/06/2026 10:29 AM GMT +07:00 -->
    <TextView
        android:id="@+id/tvTimestamp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="1dp"
        android:text="--/--/---- --:--:-- GMT+07:00"
        android:textColor="#D1D5DB"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/mapCard"
        app:layout_constraintTop_toBottomOf="@id/tvCoordinates" />

</androidx.constraintlayout.widget.ConstraintLayout>
